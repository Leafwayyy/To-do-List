.DS_Store
node_modules/
.wrangler/

# Local-only reference material for coding agents (design system references,
# etc.) - not app code, never deployed.
reference/

# Secrets - none of these exist in the repo today (the Gemini key is set via
# `wrangler secret put`, never a file), but ignored defensively so one never
# gets committed by accident later.
.env
.env.*
worker/.dev.vars
worker/.dev.vars.*
*.pem
serviceAccountKey*.json
# Playwright CLI output (may contain credentials)
.playwright-cli/

# A downloaded Google service-account key (used by the email worker) must NEVER be committed.
todo-list-*.json
*-firebase-adminsdk-*.json
*service-account*.json
worker/.dev.vars
