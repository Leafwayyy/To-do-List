rules_version = '2';

service cloud.firestore {
  // Feature 9: group roles. adminIds is a plain array (not a {uid: role}
  // map) - there's only one delegated tier below owner, so an array lets
  // every admin-aware rule below reuse the same size-delta/hasAll idiom the
  // membership rules already use, instead of introducing map-diff syntax
  // nowhere else in this file. Missing adminIds (any group created before
  // this feature shipped) reads as "no admins" - never a crash, never
  // treated as "everyone's an admin".
  function adminIdsOf(groupData) {
    return ('adminIds' in groupData) ? groupData.adminIds : [];
  }
  function isAdmin(groupData) {
    return request.auth.uid in adminIdsOf(groupData);
  }
  function isOwnerOrAdmin(groupData) {
    return request.auth.uid == groupData.ownerId || isAdmin(groupData);
  }
  // The single uid that arrayUnion just appended, for the "approve a join
  // request" branch below - relies on approveJoinRequest() always using
  // arrayUnion (which lands a not-already-present value at the end of the
  // array), never inserting anywhere else.
  function newlyAddedMemberId(newMemberIds) {
    return newMemberIds[newMemberIds.size() - 1];
  }
  function isPendingJoinRequest(db, groupId, uid) {
    return exists(/databases/$(db)/documents/groups/$(groupId)/joinRequests/$(uid))
      && get(/databases/$(db)/documents/groups/$(groupId)/joinRequests/$(uid)).data.status == 'pending';
  }

  match /databases/{database}/documents {

    // Feature 2: each signed-in user can only read/write their own profile doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Feature 3: each signed-in user can only read/write their own tasks.
    // Writes are also capped in size/shape so a buggy client (or a bad
    // actor with valid credentials) can't stuff huge or malformed docs into
    // Firestore - mirrors the size limits already used on group comments
    // and suggestions below.
    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (!('subtasks' in request.resource.data) || request.resource.data.subtasks.size() <= 200);
    }

    // Dusty's memory - short, user-visible facts Dusty asked to remember
    // and the user explicitly confirmed (see brain-dump.js's
    // createMemoryReviewCard/commitMemories). Personal to the account, not
    // group-scoped, same reasoning as solo tasks above. Add/delete only -
    // no update rule, same "immutable once posted" simplicity as group
    // comments; editing a memory means deleting it and letting Dusty (or
    // the user, from Settings) note a new one.
    match /users/{uid}/dustyMemory/{memoryId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300;
    }

    // A narrow, non-identifying mirror of just the streak count and earned
    // badge ids - readable by ANY signed-in user (not owner-only, unlike
    // every other users/{uid} subcollection in this file), specifically so
    // group/group.js's roster streak-flame can read a teammate's streak
    // without the users/{uid} doc itself needing to open up (that doc also
    // carries email/displayName, which group members should NOT gain read
    // access to just for a streak flame). The app itself only ever shows
    // this inside a shared group's roster, but the rule can't cheaply prove
    // "shares a group with me" without a specific groupId in the path (see
    // every group-scoped rule elsewhere in this file, which always takes
    // one) - exposing a bare streak number and badge ids to any signed-in
    // account, with nothing else attached, was judged an acceptable
    // narrowing rather than reusing/widening the real profile doc's rule.
    match /users/{uid}/public/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.current is int
        && request.resource.data.badges is list
        && request.resource.data.badges.size() <= 20;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Solo's own completion log - the sibling to the group history rule
    // further down, giving the streak/badge feature a durable per-completion
    // record instead of trusting only the client's local activity counters
    // (which live in localStorage and were never synced). Delete is allowed
    // (unlike group's owner-or-group-owner delete) because un-completing a
    // task here removes its own matching entry - see setTaskCompletedState
    // in script.js. Immutable otherwise (no update rule), same as every
    // other event log in this file.
    match /users/{uid}/history/{entryId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.taskText is string
        && request.resource.data.taskText.size() > 0
        && request.resource.data.taskText.size() <= 2000;
    }

    // Feedback / bug reports, submitted from Settings -> Feedback. A
    // top-level collection (not nested under users/{uid}) on purpose, so
    // every submission is browsable at once from the Firebase console
    // instead of needing a collection-group query. Read is capped to your
    // own submissions, same as everything else personal in this file; no
    // update/delete from the client at all - a status change (open -> looked
    // at -> done) happens by hand in the console, not through the app.
    match /feedback/{feedbackId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['bug', 'idea', 'feedback', 'remove']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
    }

    // Feature 4: groups. The invite code IS the document ID (see
    // group-app/src/groups.js), which is what lets "join by code" work as a
    // narrow, self-contained security rule below instead of needing a Cloud
    // Function to broker the join. memberNames is a parallel array to
    // memberIds (same index = same person) so the roster can show real
    // names without needing a separate cross-user profile-read rule.
    match /groups/{groupId} {
      // Only members can read a group's data.
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;

      // Creating a group: you must be its sole owner and sole member, and
      // the invite code you set must equal the document ID you're writing to.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberNames.size() == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.inviteCode == groupId;

      // Joining by code: the write may ONLY append your own uid (and your
      // display name, in lockstep) to the member lists, one at a time, and
      // change nothing else about the group. This is what lets someone who
      // isn't a member yet join at all, since Firestore evaluates write
      // rules independently of read rules. Only when the group is 'open' -
      // an 'invite-only' group instead routes through the joinRequests
      // subcollection below, and 'closed' blocks new members entirely.
      // Missing privacy (any group created before this feature shipped)
      // reads as 'open', so existing groups keep today's exact behavior.
      //
      // Leaving is the mirror image: the write may ONLY remove your own uid
      // (and name) from the lists, one at a time - plus your own uid from
      // adminIds, in the same write, if you happened to be an admin (an
      // admin who leaves without this would keep a stale, still-privileged
      // entry in adminIds forever). Requiring the member count to shrink by
      // exactly one, plus "you're gone from the new list", together force
      // the removed entry to be your own - removing a different single
      // member would leave you still present and fail the second check,
      // and removing more than one would fail the count check. The owner
      // can't use this path (see the separate owner-leaves branch below,
      // which also hands ownership to someone else in the same write - a
      // group is never left without an owner).
      allow update: if request.auth != null
        && (
          (
            (resource.data.privacy == 'open' || !('privacy' in resource.data))
            // memberJoinedAt is allowed here too (a dot-path write from the
            // client only ever touches your own key in it - see joinGroup
            // in groups-data.js) but not deeply validated key-by-key, same
            // trust level memberNames' actual string contents already get
            // below; it's informational (drives a friendly one-time UI
            // card), not access-gating, so that's an intentional choice,
            // not an oversight.
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberNames', 'memberJoinedAt'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberNames.size() == request.resource.data.memberIds.size()
            && request.auth.uid in request.resource.data.memberIds
            && !(request.auth.uid in resource.data.memberIds)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberNames', 'adminIds'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && request.resource.data.memberNames.size() == request.resource.data.memberIds.size()
            && request.auth.uid in resource.data.memberIds
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.auth.uid != resource.data.ownerId
            && request.resource.data.memberIds.hasAll(adminIdsOf(request.resource.data))
          )
          // The owner leaving: same shape as the plain self-leave branch
          // above (exactly your own uid removed from the lists), except
          // it's the owner leaving, and ownership must be handed to
          // someone still left in the group in the same write - never
          // yourself, always a real remaining member, and never left
          // stuck also listed as their own admin (mirrors the "owner never
          // doubles up as their own admin" invariant the promote/demote
          // branch enforces below). Which specific remaining member becomes
          // owner isn't this rule's business - the client picks (currently
          // at random) and this just validates the result. Only fires when
          // at least one other member remains; the lone-owner case has
          // nobody to hand off to, so the client blocks it and points at
          // deleting the group instead.
          || (
            request.auth.uid == resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberNames', 'ownerId', 'adminIds'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && request.resource.data.memberNames.size() == request.resource.data.memberIds.size()
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.ownerId != request.auth.uid
            && request.resource.data.ownerId in request.resource.data.memberIds
            && !(request.resource.data.ownerId in adminIdsOf(request.resource.data))
            && request.resource.data.memberIds.hasAll(adminIdsOf(request.resource.data))
          )
          // Renaming: owner-only, and only the name field changes.
          || (
            request.auth.uid == resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
          )
          // Approving a pending join request: the owner or an admin appends
          // someone ELSE's uid - distinct from the self-join branch above,
          // which requires the actor's own uid to be the one added. Requires
          // a matching joinRequests/{newUid} doc that's still 'pending', so
          // this can't be used to add an arbitrary uid out of nowhere.
          || (
            isOwnerOrAdmin(resource.data)
            // memberJoinedAt allowed here too - same reasoning as the direct-
            // join branch above (approveJoinRequest in groups-data.js sets
            // it, dot-path, for the requester being approved in this same
            // write).
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberNames', 'memberJoinedAt'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberNames.size() == request.resource.data.memberIds.size()
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && !(newlyAddedMemberId(request.resource.data.memberIds) in resource.data.memberIds)
            && isPendingJoinRequest(database, groupId, newlyAddedMemberId(request.resource.data.memberIds))
          )
          // Kicking: the owner may remove anyone but themselves; an admin
          // may only remove a plain member (never another admin, never the
          // owner - enforced by requiring a plain-admin actor to leave
          // adminIds completely untouched, which is impossible if the
          // removed uid was already in it). If the removed member happened
          // to be an admin, the SAME write must also drop them from
          // adminIds (mirrors the leave branch's own-admin cleanup above).
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberNames', 'adminIds'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && request.resource.data.memberNames.size() == request.resource.data.memberIds.size()
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && request.resource.data.memberIds.hasAll(adminIdsOf(request.resource.data))
            && resource.data.ownerId in request.resource.data.memberIds
            && request.auth.uid in request.resource.data.memberIds
            && (
              request.auth.uid == resource.data.ownerId
              || (isAdmin(resource.data) && adminIdsOf(resource.data) == adminIdsOf(request.resource.data))
            )
          )
          // Promoting/demoting an admin: owner-only, exactly one uid added
          // or removed from adminIds, every admin (old and new) still a
          // real member, and the owner never doubles up as their own admin.
          || (
            request.auth.uid == resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds'])
            && resource.data.memberIds.hasAll(adminIdsOf(request.resource.data))
            && !(resource.data.ownerId in adminIdsOf(request.resource.data))
            && (
              (
                adminIdsOf(request.resource.data).size() == adminIdsOf(resource.data).size() + 1
                && adminIdsOf(request.resource.data).hasAll(adminIdsOf(resource.data))
              )
              || (
                adminIdsOf(request.resource.data).size() == adminIdsOf(resource.data).size() - 1
                && adminIdsOf(resource.data).hasAll(adminIdsOf(request.resource.data))
              )
            )
          )
          // Changing who can join: owner-only, and only the privacy field
          // changes, to one of the three known values.
          || (
            request.auth.uid == resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['privacy'])
            && request.resource.data.privacy in ['open', 'invite-only', 'closed']
          )
          // Dismissing your own new-member catch-up card: any member may
          // update ONLY catchUpDismissed, and only ever set their OWN uid's
          // entry (never anyone else's, never someone else's card) to true.
          // Not membership-only trust the way memberJoinedAt above is - this
          // one gates a real never-comes-back state, so it's actually
          // validated key-by-key via a map diff of its own, not just a
          // top-level affectedKeys() check.
          || (
            request.auth.uid in resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['catchUpDismissed'])
            && request.resource.data.catchUpDismissed[request.auth.uid] == true
            && request.resource.data.catchUpDismissed
                .diff(('catchUpDismissed' in resource.data) ? resource.data.catchUpDismissed : {})
                .affectedKeys().hasOnly([request.auth.uid])
          )
        );

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      // Feature 9 (join requests): how someone joins an 'invite-only' group.
      // The doc ID is the requester's own uid (same "ID is the identity"
      // convention as groups/{inviteCode} and users/{uid} above) - every
      // rule below reduces to a one-line uid check, and it naturally caps
      // each person to one outstanding request per group instead of piling
      // up duplicates. Approving deletes this doc as part of the same
      // client-side write batch that adds the member (see approveJoinRequest
      // in group/groups-data.js); denying flips status to 'denied' and
      // keeps the doc so the requester gets durable feedback instead of
      // Firestore silently losing the "no".
      match /joinRequests/{requestId} {
        allow read: if request.auth != null
          && (request.auth.uid == requestId || isOwnerOrAdmin(get(/databases/$(database)/documents/groups/$(groupId)).data));

        // Requesting to join: only for yourself, only while you're not
        // already a member, and only when the group is actually
        // invite-only (an 'open' group uses the direct join branch above
        // instead of ever creating a request doc; a 'closed' group blocks
        // this path entirely, same as it blocks direct joins).
        allow create: if request.auth != null
          && request.auth.uid == requestId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && !(request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds)
          && get(/databases/$(database)/documents/groups/$(groupId)).data.privacy == 'invite-only';

        allow update: if request.auth != null
          && (
            // Re-requesting after a denial: flip your own denied doc back
            // to pending, nothing else about it changes.
            (
              request.auth.uid == requestId
              && resource.data.status == 'denied'
              && request.resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requestedAt', 'respondedAt'])
              && !(request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds)
              && get(/databases/$(database)/documents/groups/$(groupId)).data.privacy == 'invite-only'
            )
            // Denying: the owner or an admin flips pending -> denied.
            || (
              isOwnerOrAdmin(get(/databases/$(database)/documents/groups/$(groupId)).data)
              && resource.data.status == 'pending'
              && request.resource.data.status == 'denied'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
            )
          );

        // Retracting your own request, or the owner/admin clearing any
        // request - the latter also covers the second half of approval
        // (deleting the request once the member has been added).
        allow delete: if request.auth != null
          && (request.auth.uid == requestId || isOwnerOrAdmin(get(/databases/$(database)/documents/groups/$(groupId)).data));
      }

      // Feature 5: each member's tasks within the group. Any member can
      // read the whole group's tasks (that's the point - visible progress);
      // only the task's own owner can ever edit or delete it - deliberately
      // not the group's owner too, even to clean up when the group itself
      // is deleted (see deleteGroupCompletely in group/groups-data.js,
      // which only deletes the deleting owner's own tasks and accepts that
      // everyone else's task docs are left behind, orphaned, rather than
      // giving the group owner standing "delete anyone's task" power).
      match /tasks/{taskId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        // Size/type caps mirror the ones on solo tasks (users/{uid}/tasks
        // above) so a group task can't be stuffed with an oversized or
        // malformed payload either.
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (!('subtasks' in request.resource.data) || request.resource.data.subtasks.size() <= 200);
        // The task's own owner can change anything about it (subject to the
        // same size caps). Any other group member may ONLY bump the two
        // denormalized comment-count fields (see addComment/deleteComment) -
        // never the task's real content - which is what lets the
        // unread-comments indicator work off the already-loaded task list
        // instead of a listener per task.
        //
        // Security review fix: this used to accept ANY value for
        // commentCount/lastCommentAt as long as no other field changed, so
        // any group member could set commentCount to an arbitrary number
        // (hide real unread comments by zeroing it, or fake activity with a
        // huge one) and fake lastCommentAt to any timestamp. Now split into
        // two shapes: a real add/delete only ever moves commentCount by
        // exactly 1 and, if it also touches lastCommentAt, that value must
        // be request.time (a real server timestamp, not client-supplied) -
        // matches addComment/deleteComment in group.js exactly. The second
        // shape is healCommentCountIfStale's one-field correction (comments
        // that predate this counter never bumped it, so the stored number
        // can be stale) - commentCount-only, any integer value (see the
        // branch's own comment for why there's no floor), still can't touch
        // lastCommentAt or the task's real content. Rules
        // can't cheaply verify commentCount against the actual comments
        // subcollection size, so a member using this second shape as cover
        // could still write a plausible-but-wrong count; closing that fully
        // would need a server-authoritative counter (a Cloud Function),
        // out of scope here - this closes the actual reported gap (an
        // arbitrary value combined with a faked "just happened" timestamp).
        //
        // Feature 10 (task handoff): ownerId itself is now allowed to change,
        // but ONLY via the accept/decline branches below - the recipient of
        // a pending handoffRequest accepting it. This is the plan's single
        // biggest data-integrity risk (see plan's C.2 risk notes): the owner
        // branch explicitly pins ownerId to its current value so the
        // current owner can never silently reassign their own task by
        // editing it normally, and there is deliberately no separate
        // handoffRequests collection - the pending request lives as one
        // `handoffRequest` field right on this same document, so accepting
        // it (ownerId flips + the field clears) is a single atomic write,
        // not two racing ones. The accept branch's own commentCount/
        // lastCommentAt ride-along (for the "took over this task" comment
        // acceptTaskHandoff() posts in the same batch) reuses this same
        // +1/request.time validation, not a separate unchecked allowance.
        allow update: if request.auth != null
          && (
            (
              request.auth.uid == resource.data.ownerId
              && request.resource.data.ownerId == resource.data.ownerId
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000
              && (!('subtasks' in request.resource.data) || request.resource.data.subtasks.size() <= 200)
              // The owner may set handoffRequest to null (no request / just
              // cancelled one) or to a well-formed request naming a real
              // teammate other than themself - never anyone else's field.
              && (
                !('handoffRequest' in request.resource.data)
                || request.resource.data.handoffRequest == null
                || (
                  request.resource.data.handoffRequest.toUserId is string
                  && request.resource.data.handoffRequest.toUserId != resource.data.ownerId
                  && request.resource.data.handoffRequest.toUserId
                    in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
                )
              )
            )
            || (
              request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
              && (
                (
                  // No >= 0 floor here on purpose: deleteComment's
                  // increment(-1) on a task whose stored count predates
                  // this counter (never incremented for old comments, see
                  // healCommentCountIfStale's own comment) can legitimately
                  // go negative, and this is a batched write together with
                  // the comment doc's own delete - rejecting it here would
                  // fail that whole batch, undoing a real delete over a
                  // cosmetic display number. Just requires it stay an int,
                  // not the task's real content.
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
                  && request.resource.data.commentCount is int
                )
                || (
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastCommentAt'])
                  && request.resource.data.commentCount is int
                  && (
                    request.resource.data.commentCount == resource.data.commentCount + 1
                    || request.resource.data.commentCount == resource.data.commentCount - 1
                  )
                  && (
                    !('lastCommentAt' in request.resource.data.diff(resource.data).affectedKeys())
                    || request.resource.data.lastCommentAt == request.time
                  )
                )
              )
            )
            || (
              // Accept: only the person a pending request actually names can
              // take it, and only while they're still a real member of this
              // group - leaving/being kicked between being named and
              // responding must not leave a standing write path into a
              // group they're no longer part of, same membership check
              // every other group-scoped rule in this file already makes.
              // The write may ONLY flip ownerId to themself and clear the
              // request. acceptTaskHandoff() always posts its "took over
              // this task" comment in the same batch, so commentCount/
              // lastCommentAt ride along too, held to the exact same
              // +1/request.time shape the comment-count branch above
              // requires for a real add - never a bare unchecked allowance.
              'handoffRequest' in resource.data
              && resource.data.handoffRequest != null
              && resource.data.handoffRequest.toUserId == request.auth.uid
              && request.auth.uid != resource.data.ownerId
              && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
              && request.resource.data.ownerId == request.auth.uid
              && request.resource.data.handoffRequest == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['ownerId', 'handoffRequest', 'commentCount', 'lastCommentAt'])
              && request.resource.data.commentCount == resource.data.commentCount + 1
              && request.resource.data.lastCommentAt == request.time
            )
            || (
              // Decline: the same named recipient (while still a member,
              // same reasoning as accept above) may clear the request
              // without taking the task - ownerId does not change.
              'handoffRequest' in resource.data
              && resource.data.handoffRequest != null
              && resource.data.handoffRequest.toUserId == request.auth.uid
              && request.auth.uid != resource.data.ownerId
              && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
              && request.resource.data.handoffRequest == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handoffRequest'])
            )
          );
        allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

        // Feature 7: a discussion thread under each task. Any member can
        // read/post; only the comment's own author can delete it. No
        // update rule - comments aren't editable after posting, kept
        // simple on purpose.
        match /comments/{commentId} {
          allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow create: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500;
          allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
        }
      }

      // Feature 7 (suggestions half): "suggest a task for them" - proposes
      // a brand new task for a specific teammate, who can accept it (which
      // creates a real task via the normal task-create rule above, owned
      // by them) or dismiss it. Not tied to any existing task, so it's its
      // own top-level subcollection rather than nested under /tasks.
      match /suggestions/{suggestionId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.forUserId in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && request.resource.data.status == 'pending'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 240;
        // Only the person the suggestion is FOR can accept/dismiss it, and
        // only status + resolvedAt change together - they can't rewrite
        // what was suggested. resolvedAt (a real server timestamp, not
        // status alone) is what group.js's suggestionOutcomesCount gates
        // on, so a suggestion resolved before this field existed is never
        // mistaken for a fresh outcome - see the C.1 plan's Risks section.
        allow update: if request.auth != null
          && request.auth.uid == resource.data.forUserId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
          && request.resource.data.status in ['accepted', 'dismissed']
          && request.resource.data.resolvedAt is timestamp;
        // The original sender marking a resolved outcome as seen - the
        // only field they're ever allowed to touch, and only once the
        // recipient has actually acted (status != 'pending'), so a sender
        // can't use this to pre-clear their own notification before that.
        allow update: if request.auth != null
          && request.auth.uid == resource.data.fromUserId
          && resource.data.status != 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBySender'])
          && request.resource.data.acknowledgedBySender == true;
        // Either side of a still-pending suggestion can retract/clear it;
        // once acted on, it stays as a record.
        allow delete: if request.auth != null
          && resource.data.status == 'pending'
          && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.forUserId);
      }

      // Feature 8: a permanent completion log for the "Recently finished"
      // panel, kept as its own top-level subcollection (not nested under
      // /tasks) specifically so it survives a task being deleted later -
      // that's the whole point of it existing instead of the panel just
      // filtering the live task list. Entries are immutable (no update
      // rule), same as comments.
      match /history/{entryId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.taskText is string
          && request.resource.data.taskText.size() > 0
          && request.resource.data.taskText.size() <= 2000;
        // Own-entry delete lets a leaving/deleted member's own history clean
        // itself up; group-owner delete lets deleteGroupCompletely wipe the
        // whole log along with everything else when the group itself goes.
        allow delete: if request.auth != null
          && (
            request.auth.uid == resource.data.ownerId
            || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
          );
      }
    }
  }
}
